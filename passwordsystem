def password_strength():
    letters = 26
    numbers = 10
    weak = 0

    total_letters = letters ** 2
    total_numbers = numbers ** 2

    total = total_letters * total_numbers

    repeating_letters = letters * total_numbers
    repeating_numbers = numbers * total_letters
    overlap = letters * numbers

    weak = (repeating_letters + repeating_numbers) - overlap

    strong = total - weak
    
    print("Total passwords: ", total)
    print("Weak passwords: ", weak)
    print("Strong passwords: ", strong)

password_strength()